    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;07 · Guia — Operação e evals&lt;/b&gt;&lt;br&gt;&lt;br&gt;Preocupações transversais • Instrumentar Edge → Agent → Tools → Services → dados/providers; não adicionar judge obrigatório ao runtime." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=20;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1740" height="95" />
        </mxCell>
        <mxCell id="obs" value="&lt;b&gt;AI Observability / distributed tracing&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenTelemetry / LangSmith / Prometheus-Grafana ou equivalentes&lt;br&gt;traceId • conversationId • tenantId • agentId • model&lt;br&gt;Tool calls • retrievals • latency • errors • agent steps&lt;br&gt;Input/output tokens • custo • filas • sucesso da tarefa&lt;br&gt;Métricas agregadas + traces com acesso controlado&lt;br&gt;Não logar prompts completos, dados médicos ou PII indiscriminadamente." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="160" width="830" height="245" />
        </mxCell>
        <mxCell id="security" value="&lt;b&gt;Security / privacidade&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authentication • Authorization • Tenant Isolation • Least Privilege&lt;br&gt;Encryption in Transit / at Rest • Secrets Management&lt;br&gt;LGPD • minimização • retenção / exclusão • PII masking/redaction&lt;br&gt;Guardrails • prompt injection protection • Audit Logs&lt;br&gt;RAG é dado não confiável; documentos não autorizam tools.&lt;br&gt;Avaliar retenção/uso de dados e condições dos providers antes de enviar dados." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="160" width="860" height="245" />
        </mxCell>
        <mxCell id="cost" value="&lt;b&gt;AI Cost Control&lt;/b&gt;&lt;br&gt;&lt;br&gt;Input/output tokens; cost per request / agent / tenant / successful task&lt;br&gt;Model routing • context truncation • summarization • Top-K control&lt;br&gt;Caching com isolamento • max steps • max token budget&lt;br&gt;Timeout • recursion/loop protection • quotas por tenant&lt;br&gt;Preservar instruções e fatos críticos ao resumir; medir perda de qualidade." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="455" width="830" height="225" />
        </mxCell>
        <mxCell id="resilience" value="&lt;b&gt;Resilience / chamadas externas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Timeout por etapa + deadline total • Retry limitado&lt;br&gt;Exponential Backoff + Jitter • Circuit Breaker • Fallback&lt;br&gt;Retry somente para falhas transitórias, respeitando idempotência.&lt;br&gt;Não repetir validação, falta de permissão ou conflito de horário.&lt;br&gt;Fallback must be validated because providers/models may behave differently.&lt;br&gt;Sem provider: degradação explícita / atendimento humano, sem inventar sucesso." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="455" width="860" height="225" />
        </mxCell>
        <mxCell id="dataset" value="&lt;b&gt;Evaluation Dataset&lt;/b&gt;&lt;br&gt;&lt;br&gt;Casos representativos e adversariais&lt;br&gt;Dados sintéticos / anonimizados&lt;br&gt;Casos de isolamento multi-tenant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="785" width="350" height="150" />
        </mxCell>
        <mxCell id="version" value="&lt;b&gt;Agent Version&lt;/b&gt;&lt;br&gt;&lt;br&gt;Versionar prompt / tools / modelo&lt;br&gt;Retriever / índice / configuração&lt;br&gt;Reproduzir execução com dataset" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="785" width="350" height="150" />
        </mxCell>
        <mxCell id="eval" value="&lt;b&gt;Evaluation / offline&lt;/b&gt;&lt;br&gt;&lt;br&gt;Assertions determinísticas&lt;br&gt;LLM-as-a-Judge como técnica&lt;br&gt;Revisão humana / calibração" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="785" width="420" height="150" />
        </mxCell>
        <mxCell id="metrics" value="&lt;b&gt;Metrics / decisão de release&lt;/b&gt;&lt;br&gt;&lt;br&gt;Factuality / hallucination&lt;br&gt;Correct tool usage / retrieval quality&lt;br&gt;Policy compliance / safety&lt;br&gt;Latência / custo / sucesso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1330" y="785" width="440" height="170" />
        </mxCell>
        <mxCell id="judge" value="&lt;b&gt;Offline Evals / Quality Pipeline&lt;/b&gt;&lt;br&gt;&lt;br&gt;Evals antes de produção; critérios de aceitação definidos por risco.&lt;br&gt;Prefer offline evals; online judge only when justified or sampled.&lt;br&gt;Judge tem viés/custo e não substitui testes de regras ou revisão humana.&lt;br&gt;Testar documento com injection, tenant incorreto, tool duplicada e reserva concorrente." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1015" width="830" height="180" />
        </mxCell>
        <mxCell id="scale" value="&lt;b&gt;Escalabilidade ponta a ponta&lt;/b&gt;&lt;br&gt;&lt;br&gt;API/BFF, Agent, Backend, RAG e Workers: Horizontal Scaling / Multiple Instances.&lt;br&gt;Autoscaling: requests / latência / CPU / memória; ingestão: queue depth / idade.&lt;br&gt;Considerar throughput/quotas do LLM, pool/locks do DB e capacidade do Vector DB.&lt;br&gt;Backpressure, limites por tenant e filas evitam que um tenant monopolize recursos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="1015" width="860" height="180" />
        </mxCell>
        <mxCell id="slo" value="&lt;b&gt;Definir metas antes de dimensionar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Perguntas abertas: usuários/clinicas, pico de requests, concorrência, volume e tamanho de documentos, frequência de atualização.&lt;br&gt;Definir SLOs de p95 de latência, disponibilidade, frescor do índice, qualidade mínima, orçamento e política de recuperação.&lt;br&gt;Streaming SSE melhora percepção de latência, mas não reduz custo nem elimina deadline.&lt;br&gt;Validar decisões com carga, evals, falhas simuladas e medições; nenhuma meta numérica é presumida." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1255" width="1740" height="185" />
        </mxCell>
