  <diagram name="09 · Fluxos críticos de produção" id="production-flows">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;09 · Fluxos críticos de produção&lt;/b&gt;&lt;br&gt;&lt;br&gt;Caminhos obrigatórios para testar antes de colocar a aplicação agêntica em produção. Controles determinísticos ficam fora da LLM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=20;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1740" height="95" />
        </mxCell>
        <mxCell id="faq-miss" value="&lt;b&gt;1 · FAQ — cache miss&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gateway (auth + limites) → Conversation → Redis miss → Agent.&lt;br&gt;searchClinicKnowledge → API Gateway → Knowledge → embedding com budget → pgvector filtrado.&lt;br&gt;Fontes → Agent → AI Gateway → Model Router → LLM → resposta elegível → Redis.&lt;br&gt;Namespace tenant/clinic; TTL, versão, permissões e contexto; contabilizar todas as chamadas." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="160" width="830" height="195" />
        </mxCell>
        <mxCell id="faq-hit" value="&lt;b&gt;2 · FAQ repetida — cache hit&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gateway (auth + limites) → Conversation → Redis hit autorizado → resposta, sem Agent/RAG/LLM.&lt;br&gt;Namespace tenant/clinic; answer-cache:{patientId}:{questionHash} apenas para o mesmo paciente.&lt;br&gt;Shared cache: só conteúdo não pessoal; contexto/permissões/versão compatíveis.&lt;br&gt;Contar request; hit não consome chamadas de modelo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="160" width="860" height="195" />
        </mxCell>
        <mxCell id="slots" value="&lt;b&gt;3 · Consulta de agenda&lt;/b&gt;&lt;br&gt;&lt;br&gt;Agent → getAvailableSlots Tool → API Gateway → Scheduling Service → PostgreSQL.&lt;br&gt;Um cache de agenda de TTL curto pode orientar a leitura; a fonte oficial é PostgreSQL.&lt;br&gt;Resposta de disponibilidade não é reserva." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="410" width="830" height="175" />
        </mxCell>
        <mxCell id="booking" value="&lt;b&gt;4 · Agendamento com efeito persistente&lt;/b&gt;&lt;br&gt;&lt;br&gt;Intenção + chave → Tool → Gateway → Scheduling: autorização e dedupe.&lt;br&gt;PostgreSQL: revalidar slot → integridade concorrente → transação (reserva + resultado + evento).&lt;br&gt;Commit → audit/invalidação versionada/notificação recuperáveis; retry com a mesma chave." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="410" width="860" height="175" />
        </mxCell>
        <mxCell id="fallback" value="&lt;b&gt;5 · Provider LLM indisponível&lt;/b&gt;&lt;br&gt;&lt;br&gt;Agent → AI Gateway → timeout / circuit breaker → fallback de modelo/provider validado por evals.&lt;br&gt;Retry é limitado, com backoff + jitter e sem amplificação. Sem alternativa segura, degradar explicitamente.&lt;br&gt;Writes não são repetidos sem idempotência." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="640" width="830" height="185" />
        </mxCell>
        <mxCell id="abuse" value="&lt;b&gt;6 · Abuso/script — bloquear antes da IA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gateway → limites Redis atômicos por tenant/ator; origem/canal para anônimos.&lt;br&gt;Quota/budget ou concurrency excedido → bloquear antes de Agent/RAG/LLM.&lt;br&gt;Reservar budget antes de cada chamada cara; retries/fallback contam no total.&lt;br&gt;Redis fora → negar operações caras; janela de quota não depende da sessão." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="640" width="860" height="185" />
        </mxCell>
        <mxCell id="checklist" value="&lt;b&gt;Verificações de produção&lt;/b&gt;&lt;br&gt;&lt;br&gt;Isolamento de tenant/clinic/paciente em cache e retrieval; cache hit com contexto válido sem IA.&lt;br&gt;Budget atômico entre instâncias, incluindo embeddings, retries/fallback; comportamento com Redis fora.&lt;br&gt;Dedupe durável antes do ACK; chamadas duplicadas/concorrentes e reagendamento atômico.&lt;br&gt;Falha após commit recupera audit, invalidação e notificação; documentos maliciosos não autorizam tools.&lt;br&gt;Combinar evals determinísticos, Judge calibrado e revisão humana conforme risco." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="885" width="1740" height="180" />
        </mxCell>
