  <diagram name="08 · Guia — Evolução e falhas" id="page-5">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;08 · Guia — Evolução e falhas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Guia de estudo • Toda decisão equilibra qualidade, custo, latência e segurança. Componentes opcionais não são dependências do MVP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=20;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1740" height="95" />
        </mxCell>
        <mxCell id="mvp" value="&lt;b&gt;MVP • controles de produção necessários&lt;/b&gt;&lt;br&gt;&lt;br&gt;Web/WhatsApp; Gateway com TLS, auth, rate limit, quota e tracing.&lt;br&gt;Conversation/Agent Runtime com Redis para sessão, cache, uso e limites.&lt;br&gt;AI Gateway, tools restritas e serviços determinísticos via API Gateway.&lt;br&gt;PostgreSQL source of truth + pgvector; ingestão segura, async e idempotente.&lt;br&gt;Reserva atômica, audit, observabilidade e evals antes de release.&lt;br&gt;Serviços são módulos lógicos; não exigem deployment por caixa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="160" width="830" height="265" />
        </mxCell>
        <mxCell id="evolution" value="&lt;b&gt;Evolução / quando houver evidência&lt;/b&gt;&lt;br&gt;&lt;br&gt;Avaliar HNSW ou IVFFlat com filtros; medir qualidade/latência antes de escolher.&lt;br&gt;Separação de serviços/autoscaling conforme carga real; gateways são responsabilidades lógicas.&lt;br&gt;Fallbacks avaliados; multiagentes só se melhorarem sucesso total medido.&lt;br&gt;Bulkheads/caches adicionais conforme gargalo; judge online/HITL conforme risco.&lt;br&gt;Broker: Kafka, RabbitMQ ou SQS conforme necessidade; não exigir todos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="160" width="860" height="265" />
        </mxCell>
        <mxCell id="trade" value="&lt;b&gt;Principais trade-offs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mais agentes: + especialização / isolamento de contexto; − tokens, latência, complexidade e observabilidade.&lt;br&gt;Top-K maior: + cobertura; − custo, ruído e espaço de contexto. RAG não garante factualidade.&lt;br&gt;Cache: + menor custo/latência; − invalidação, frescor e risco de isolamento incorreto.&lt;br&gt;Async ingestão: + desacoplamento / throughput; − consistência eventual e operação de retries.&lt;br&gt;Monólito modular: + simplicidade; extração de serviços: + escala independente, − complexidade distribuída.&lt;br&gt;Modelo mais forte: possível ganho de qualidade; medir custo/latência. Fallback exige evals.&lt;br&gt;Banco vetorial compartilhado: operação simples, isolamento deve ser imposto; índices separados aumentam operação." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="480" width="1740" height="235" />
        </mxCell>
        <mxCell id="fail1" value="&lt;b&gt;Cenários de falha • 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Provider indisponível → AI Gateway, fallback avaliado dentro do budget ou degradação explícita.&lt;br&gt;Retrieval indisponível → reconhecer limite; agenda pode continuar se PostgreSQL estiver saudável.&lt;br&gt;PostgreSQL indisponível → não confirmar reservas nem usar cache como fonte oficial.&lt;br&gt;RAG incorreto/desatualizado → fontes, abstinência, versão ativa, evals e invalidação.&lt;br&gt;Loop do agente → maxSteps, tokens, custo e deadline.&lt;br&gt;Tool repetida → mesma chave/ator/payload; único efeito." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="770" width="830" height="365" />
        </mxCell>
        <mxCell id="fail2" value="&lt;b&gt;Cenários de falha • 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;Disputa de slot → transação + integridade; reagendamento atômico.&lt;br&gt;Tráfego 10x → limites compartilhados por tenant, pools, quotas e backpressure.&lt;br&gt;Acesso cruzado → negar no serviço, retriever, sessão e cache.&lt;br&gt;Prompt injection → documentos untrusted; autorização limita tools.&lt;br&gt;Redis fora → não liberar IA sem budget/quota; dados oficiais permanecem no PostgreSQL.&lt;br&gt;Timeout após commit → reconciliar mesma chave; audit/cache/notificação recuperáveis." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="770" width="860" height="365" />
        </mxCell>
        <mxCell id="partial" value="&lt;b&gt;Failure Scenario • ingestão interrompida&lt;/b&gt;&lt;br&gt;&lt;br&gt;E se o pipeline falhar pela metade?&lt;br&gt;→ Checkpoints/status + upserts idempotentes + retry limitado + DLQ.&lt;br&gt;→ Versão incompleta fica invisível; manter a anterior até publicar a nova.&lt;br&gt;→ Reconciliar objeto/job; testar falha antes/depois de cada etapa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1190" width="830" height="165" />
        </mxCell>
        <mxCell id="original" value="&lt;b&gt;O que foi preservado e corrigido&lt;/b&gt;&lt;br&gt;&lt;br&gt;Da captura: pacientes Web/WhatsApp, LLM, agendamento, API monolítica,&lt;br&gt;documentos, banco vetorial e avaliação por judge.&lt;br&gt;Correções: chunking só em documentos; LLM atrás de orquestrador;&lt;br&gt;judge offline; agenda determinística; isolamento fora do prompt.&lt;br&gt;O XML inicial estava vazio; a captura forneceu a referência original." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="1190" width="860" height="165" />
        </mxCell>
        <mxCell id="principles" value="&lt;b&gt;Princípios para defender na entrevista&lt;/b&gt;&lt;br&gt;&lt;br&gt;Começar simples • IA propõe; backend protege regras críticas • LLM não autoriza • aplicação garante multi-tenancy&lt;br&gt;Vector DB é índice derivado • Evals antes de produção • tokens, custo e agent traces fazem parte da observabilidade&lt;br&gt;Segurança / LGPD desde o início • escalar não é só adicionar pods • justificar cada componente pelo problema que resolve" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1410" width="1740" height="150" />
        </mxCell>
