  <diagram name="07 · Guia — Operação e evals" id="page-4">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;07 · Guia — Operação e evals&lt;/b&gt;&lt;br&gt;&lt;br&gt;Preocupações transversais • Instrumentar Edge → Agent → Tools → Services → dados/providers; não adicionar judge obrigatório ao runtime." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=20;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1740" height="95" />
        </mxCell>
        <mxCell id="obs" value="&lt;b&gt;Observabilidade de IA e plataforma&lt;/b&gt;&lt;br&gt;&lt;br&gt;Logs, métricas, traces: latência, erros, throughput e cache hit ratio.&lt;br&gt;provider/model, prompt version, tokens/custo, LLM calls, tools, passos.&lt;br&gt;RAG chunks/scores (sem texto sensível), retries/fallbacks e eval results.&lt;br&gt;IDs em traces controlados; evitar labels de alta cardinalidade.&lt;br&gt;Redação/minimização: sem PII ou conversas completas indiscriminadamente." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="160" width="830" height="245" />
        </mxCell>
        <mxCell id="security" value="&lt;b&gt;Segurança, privacidade e auditoria&lt;/b&gt;&lt;br&gt;&lt;br&gt;AuthN • AuthZ • tenant isolation • least privilege • TLS&lt;br&gt;Hash não é recuperável; dados recuperáveis usam encryption at rest/in transit • KMS • key rotation • secrets&lt;br&gt;LGPD: minimização, finalidade, retenção e exclusão&lt;br&gt;Audit: actor, tenant, paciente/recurso, ação, resultado, timestamp, correlationId&lt;br&gt;Documentos/RAG são não confiáveis; tools continuam bloqueando dano." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="160" width="860" height="245" />
        </mxCell>
        <mxCell id="cost" value="&lt;b&gt;FinOps e Denial of Wallet&lt;/b&gt;&lt;br&gt;&lt;br&gt;Antes de LLM, embeddings e tools caras: rate limit, quota, concurrency e budget reservados atomicamente.&lt;br&gt;Reservar entrada + saída máxima; reconciliar consumo. Por tenant/ator; anônimos: origem/canal.&lt;br&gt;maxSteps, maxLLMCalls, maxToolCalls, maxInputTokens, maxOutputTokens, maxCost, timeout, maxRetries.&lt;br&gt;Quota independe do TTL da sessão; retries/fallback contam. Redis fora: bloquear até recuperar limites." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="455" width="830" height="225" />
        </mxCell>
        <mxCell id="resilience" value="&lt;b&gt;Resiliência e recuperação&lt;/b&gt;&lt;br&gt;&lt;br&gt;Timeout + deadline total; retry/backoff/jitter limitado, coordenado entre camadas.&lt;br&gt;AI Gateway: fallback validado por evals, sem renovar orçamento ou repetir writes.&lt;br&gt;Auditoria/notificação persistida junto da operação; publicar depois do commit, com reconciliação.&lt;br&gt;Fila + DLQ; consumidores idempotentes; analytics eventual; bulkhead quando necessário." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="455" width="860" height="225" />
        </mxCell>
        <mxCell id="dataset" value="&lt;b&gt;Evaluation Dataset&lt;/b&gt;&lt;br&gt;&lt;br&gt;Casos representativos e adversariais&lt;br&gt;Dados sintéticos / anonimizados&lt;br&gt;Casos de isolamento multi-tenant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="785" width="350" height="150" />
        </mxCell>
        <mxCell id="version" value="&lt;b&gt;Agent Version&lt;/b&gt;&lt;br&gt;&lt;br&gt;Versionar prompt / tools / modelo&lt;br&gt;Retriever / índice / configuração&lt;br&gt;Reproduzir execução com dataset" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="785" width="350" height="150" />
        </mxCell>
        <mxCell id="eval" value="&lt;b&gt;Evaluation / offline&lt;/b&gt;&lt;br&gt;&lt;br&gt;Assertions determinísticas&lt;br&gt;LLM-as-a-Judge como técnica&lt;br&gt;Revisão humana / calibração" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="785" width="420" height="150" />
        </mxCell>
        <mxCell id="metrics" value="&lt;b&gt;Métricas / decisão de release&lt;/b&gt;&lt;br&gt;&lt;br&gt;Groundedness / hallucination / retrieval relevance&lt;br&gt;Tool selection, arguments e trajectory&lt;br&gt;Segurança, custo, latência e fallback models&lt;br&gt;Policy compliance / sucesso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1330" y="785" width="440" height="170" />
        </mxCell>
        <mxCell id="judge" value="&lt;b&gt;Offline Evals / Quality Pipeline&lt;/b&gt;&lt;br&gt;&lt;br&gt;Determinísticos + LLM-as-a-Judge calibrado + revisão humana conforme risco.&lt;br&gt;Cobrir: tools/argumentos, trajetória, groundedness, retrieval, segurança, custo, latência e fallback.&lt;br&gt;Testar chamadas concorrentes, cache/contexto cruzado, budget com fallback, Redis fora e falhas após commit.&lt;br&gt;Judge online só amostrado/justificado; não substitui integridade ou autorização." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1015" width="830" height="180" />
        </mxCell>
        <mxCell id="scale" value="&lt;b&gt;Escalabilidade ponta a ponta&lt;/b&gt;&lt;br&gt;&lt;br&gt;Load Balancer → N instâncias Webhook/Conversation/Agent/Scheduling/Knowledge; estado externo.&lt;br&gt;Redis: operações atômicas para quotas, dedupe e leases de concurrency; ordem por sessão/checkpoints.&lt;br&gt;Limites por tenant e pools separados conforme carga; observar fila/idade, locks e quotas do provider.&lt;br&gt;Redis não substitui registros oficiais; uso financeiro recuperável no PostgreSQL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="1015" width="860" height="180" />
        </mxCell>
        <mxCell id="slo" value="&lt;b&gt;Definir metas antes de dimensionar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Perguntas abertas: usuários/clinicas, pico de requests, concorrência, volume e tamanho de documentos, frequência de atualização.&lt;br&gt;Definir SLOs de p95 de latência, disponibilidade, frescor do índice, qualidade mínima, orçamento e política de recuperação.&lt;br&gt;Streaming SSE melhora percepção de latência, mas não reduz custo nem elimina deadline.&lt;br&gt;Validar decisões com carga, evals, falhas simuladas e medições; nenhuma meta numérica é presumida." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;arcSize=8;strokeWidth=1;" vertex="1" parent="1">
